{
  "name": "zan-md",
  "type": "module",
  "version": "2.1.0",
  "private": false,
  "packageManager": "pnpm@12.6.0",
  "description": "超赞 Markdown 编辑器（Zan MD）| 基于 doocs/md 的衍生版，内置「维客绿」主题，可免费部署到 EdgeOne Pages 并支持 GitHub 云同步",
  "author": "mkboy95",
  "homepage": "https://github.com/mkboy95/zan-md",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkboy95/zan-md"
  },
  "bugs": {
    "url": "https://github.com/mkboy95/zan-md/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "pnpm web dev",
    "web": "pnpm --filter @md/web",
    "vscode": "pnpm --prefix ./apps/vscode",
    "vscode:test": "pnpm --prefix ./apps/vscode test",
    "mcp": "pnpm --filter @md/mcp-server",
    "api": "pnpm --filter @md/api",
    "cli": "pnpm --filter @doocs/md-cli",
    "build:cli": "pnpm web build && npx shx rm -rf packages/md-cli/dist && npx shx rm -rf dist/**/*.map && npx shx cp -r apps/web/dist packages/md-cli/ && cd packages/md-cli && npm pack",
    "release:cli": "node ./scripts/release.js",
    "lint": "eslint . --fix",
    "type-check": "pnpm type-check:web && pnpm type-check:packages",
    "type-check:web": "pnpm --filter @md/web run type-check",
    "type-check:packages": "pnpm --filter @md/core --filter @md/shared --filter @md/api --filter @md/mcp-server run type-check && pnpm --prefix ./apps/vscode run type-check",
    "test": "pnpm --filter @md/shared test && pnpm --filter @md/core test && pnpm --filter @md/web test && pnpm --filter @md/api test",
    "postinstall": "simple-git-hooks",
    "inspector": "pnpx node-modules-inspector",
    "utools:package": "node ./scripts/package-utools.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "^26.6.5",
    "archiver": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "2.8.8",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
