# md-api 后端地址（账户登录、云同步等共用）。可与 VITE_MD_API_URL 二选一。
VITE_SYNC_API_URL=http://localhost:8787

# ===== 同步后端二选一 =====
# api（默认）：用上面的 md-api；github：直接读写自己的 GitHub 仓库，无需自建后端。
# 切到 github 后，本文件里其他 VITE_SYNC_* / VITE_GITHUB_* 见下方说明。
# VITE_SYNC_BACKEND=github

# GitHub OAuth 中转地址。默认同源 `/api/auth/github`，
# 即 EdgeOne 的 edge-functions/api/auth/github.js（见 docs/deploy-edgeone.md）。
# VITE_GITHUB_OAUTH_BASE=/api/auth/github

# 数据仓库 `owner/repo`。留空则用 `<登录名>/md-sync`，不存在时自动创建私有仓库。
# VITE_GITHUB_REPO=mkboy95/md-sync

# 数据仓库分支与仓库内数据目录。
# VITE_GITHUB_BRANCH=main
# VITE_GITHUB_DATA_DIR=.md-sync

# 是否在 UI 显示账户入口（Footer 登录/账户按钮）。默认：已配置 API 即显示。
# VITE_ACCOUNT_UI_ENABLED=true

# 是否在 UI 显示云同步入口。默认：已配置 API 即显示（可被下方 false 关闭）。
VITE_SYNC_UI_ENABLED=false

# 爱发电创作者主页（Pro 升级跳转），例如 https://ifdian.net/a/doocs
VITE_AFDIAN_PAGE_URL=

# 爱发电下单页域名，与主页保持一致即可
VITE_AFDIAN_ORDER_BASE=https://ifdian.net

# 默认图床是否经 md-api 上传（需与 api wrangler.toml 的 UPLOAD_ENABLED 同步）
VITE_UPLOAD_VIA_API=true
